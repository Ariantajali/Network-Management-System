<mah:MetroWindow x:Class="Neywork_Manengment.ClientsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Clients" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <WrapPanel Margin="0,0,0,10" HorizontalAlignment="Center" VerticalAlignment="Top">
            <Button ToolTip="Refresh client list" Width="110" Height="35" Margin="5" Click="Refresh_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Refresh" Width="18" Height="18" Margin="0,0,5,0"/>
                    <TextBlock Text="Refresh"/>
                </StackPanel>
            </Button>

            <Button ToolTip="Shutdown all clients" Background="IndianRed" Foreground="White" Width="130" Height="35" Margin="5" Click="ShutdownAll_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Power" Width="18" Height="18" Margin="0,0,5,0"/>
                    <TextBlock Text="Shutdown All"/>
                </StackPanel>
            </Button>

            <Button ToolTip="Restart all clients" Background="DarkOrange" Foreground="White" Width="130" Height="35" Margin="5" Click="RestartAll_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Restart" Width="18" Height="18" Margin="0,0,5,0"/>
                    <TextBlock Text="Restart All"/>
                </StackPanel>
            </Button>

            <Button ToolTip="Lock all clients" Width="110" Height="35" Margin="5" Click="LockAll_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Lock" Width="18" Height="18" Margin="0,0,5,0"/>
                    <TextBlock Text="Lock All"/>
                </StackPanel>
            </Button>

            <Button ToolTip="Send a message to all clients" Width="150" Height="35" Margin="5" Click="MessageAll_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="MessageTextOutline" Width="18" Height="18" Margin="0,0,5,0"/>
                    <TextBlock Text="Message All"/>
                </StackPanel>
            </Button>

            <TextBox x:Name="SearchBox" Width="200" Height="35" Margin="15,0,0,0"
             mah:TextBoxHelper.Watermark="Search by Name or IP"/>
        </WrapPanel>
        <!-- DataGrid -->
        <DataGrid x:Name="ClientsDataGrid" Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  RowHeaderWidth="0"
                  AlternatingRowBackground="#F2F2F2"
                  GridLinesVisibility="Horizontal"
                  CanUserAddRows="False" MouseDoubleClick="ClientsDataGrid_MouseDoubleClick">

            <DataGrid.Resources>
                <!-- Style برای ProgressBar داخل DataGrid -->
                <Style TargetType="ProgressBar">
                    <Setter Property="Height" Value="16"/>
                    <Setter Property="Margin" Value="2"/>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <!-- System Name -->
                <DataGridTextColumn Header="System Name" Binding="{Binding SystemName}" Width="*"/>

                <!-- IP Address -->
                <DataGridTextColumn Header="IP Address" Binding="{Binding IPAddress}" Width="*"/>

                <!-- Status Icon -->
                <DataGridTemplateColumn Header="Status" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <iconPacks:PackIconMaterial Kind="{Binding StatusIcon}" Width="24" Height="24"
                                                        Foreground="{Binding StatusColor}" HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- CPU Progress -->
                <DataGridTemplateColumn Header="CPU (%)" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ProgressBar Value="{Binding CPU}" Maximum="100"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- RAM Progress -->
                <DataGridTemplateColumn Header="RAM (%)" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ProgressBar Value="{Binding RAM}" Maximum="100"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Disk Progress -->
                <DataGridTemplateColumn Header="Disk (%)" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ProgressBar Value="{Binding Disk}" Maximum="100"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</mah:MetroWindow>
