<mah:MetroWindow x:Class="Neywork_Manengment.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Neywork_Manengment"
        mc:Ignorable="d"
        Title="Login" Height="450" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#CCE6F3">

    <Grid>
        <Border Width="300" Padding="20"
                Background="#1A5276"
                CornerRadius="10"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Login" 
                           FontSize="24" FontWeight="Bold" 
                           Foreground="White" 
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBox Width="Auto" Height="40" x:Name="usernameTextBox" 
                         Margin="0,0,0,10"
                         mah:TextBoxHelper.Watermark="Username"
                         FontSize="14"/>

                <PasswordBox Width="Auto" Height="40" x:Name="pass_txbox" 
                             Margin="0,0,0,20"
                             mah:TextBoxHelper.Watermark="Password"
                             FontSize="14"/>

                <Button Content="Login" x:Name="LoginButton" Click="LoginButton_Click" 
                        Width="Auto" Height="40" 
                        Background="#28B4C8" Foreground="White"
                        FontSize="14" Margin="0,0,0,10"/>

            </StackPanel>
        </Border>
    </Grid>
</mah:MetroWindow>
