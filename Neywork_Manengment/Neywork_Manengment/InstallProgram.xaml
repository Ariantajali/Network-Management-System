<mah:MetroWindow x:Class="Neywork_Manengment.InstallProgram"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Neywork_Manengment"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Install Program" Height="550" Width="750">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Text="Install Program" FontSize="20" FontWeight="Bold" Margin="0,0,0,10" Grid.Row="0"/>

        <!-- Setup File -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,5,0,5" VerticalAlignment="Center">
            <Label Content="Setup File:" VerticalAlignment="Center"/>
            <TextBox Name="txtSetupFile" Width="400" Margin="5,0"/>
            <Button Content="Browse" Click="BrowseSetupFile_Click" Width="75"/>
        </StackPanel>

        <!-- Silent Switch -->
        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,5,0,5" VerticalAlignment="Center">
            <Label Content="Silent Install Switch:" VerticalAlignment="Center"/>
            <ComboBox Name="cmbSilentSwitch" Width="200" Margin="5,0" IsEditable="True">
                <ComboBoxItem Content="/S" IsSelected="True"/>
                <ComboBoxItem Content="/silent"/>
                <ComboBoxItem Content="/VERYSILENT"/>
                <ComboBoxItem Content="/quiet"/>
                <ComboBoxItem Content="/qn"/>
                <ComboBoxItem Content="/norestart"/>
                <ComboBoxItem Content="/passive"/>
                <ComboBoxItem Content="--silent"/>
                <ComboBoxItem Content="--quiet"/>
            </ComboBox>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="0,10,0,10" HorizontalAlignment="Left">
            <Button Name="btnInstallSelected" Content="Send and Install (Selected)" Click="btnSendFiles_Click" Width="200" Margin="5"/>
            <Button Name="btnInstallAll" Content="Send and Install (All Clients)" Click="btnSendFilesToAll_Click" Width="200" Margin="5"/>
            <Button Name="btnRefresh" Content="Refresh Clients" Click="RefreshClients_Click" Width="150" Margin="5"/>
        </StackPanel>

        <!-- Clients Table -->
        <DataGrid Name="ClientsDataGrid" Grid.Row="4" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,10,0,0" SelectionMode="Extended" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Binding="{Binding IsSelected}" Width="40" />
                <DataGridTextColumn Header="System Name" Binding="{Binding SystemName}" Width="*"/>
                <DataGridTextColumn Header="IP Address" Binding="{Binding IPAddress}" Width="*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                <DataGridTextColumn Header="CPU (%)" Binding="{Binding CPU}" Width="80"/>
                <DataGridTextColumn Header="RAM (%)" Binding="{Binding RAM}" Width="80"/>
                <DataGridTextColumn Header="Disk (%)" Binding="{Binding Disk}" Width="80"/>
                <DataGridTextColumn Header="Install Status" Binding="{Binding InstallStatus}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</mah:MetroWindow>
