<mah:MetroWindow x:Class="Neywork_Manengment.FileTransfer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Neywork_Manengment"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="FileTransfer" Height="450" Width="800">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="ClientsDataGrid" SelectionMode="Extended" AutoGenerateColumns="False" Grid.Row="0">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Select" Binding="{Binding IsSelected, Mode=TwoWay}"/>
                    <DataGridTextColumn Header="IP" Binding="{Binding IPAddress}"/>
                    <DataGridTextColumn Header="System Name" Binding="{Binding SystemName}"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="5">
                <TextBox x:Name="FilePathTextBox" Width="400" IsReadOnly="True"/>
                <Button Content="Browse..." Click="Browse_Click" Margin="5,0"/>
                <Button Content="Refresh List" Click="Refresh_Click" Margin="5,0"/>
                <Button Content="Send to All" Click="SendAll_Click" Margin="5,0" ToolTip="Send the selected file to all connected clients"/>
            </StackPanel>

            <Button Content="Send File" Grid.Row="2" Click="SendFile_Click" Margin="5"/>
        </Grid>

    </Grid>
</mah:MetroWindow>
